[sub_resource type="SpriteFrames" id="ButterflyFlight"]
animations = [{
"frames": [{"duration": 1.0, "texture": SubResource("WingsOpen")}, {"duration": 1.0, "texture": SubResource("WingsHalf")}, {"duration": 1.0, "texture": SubResource("WingsClosed")}, {"duration": 1.0, "texture": SubResource("WingsHalf")}],
"loop": true,
"name": &"fly",
"speed": 8.0
}]

[node name="GameStart" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
