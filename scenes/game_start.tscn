[sub_resource type="AtlasTexture" id="ClosedDoor"]
atlas = ExtResource("closed")
region = Rect2(1074, 462, 132, 220)

[sub_resource type="AtlasTexture" id="OpenDoor"]
atlas = ExtResource("open")
